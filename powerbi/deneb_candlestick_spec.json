{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "NEPSE Interactive Candlestick, Bollinger Bands, and Signal Visual",
  "data": {"name": "dataset"},
  "config": {
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {"gridColor": "#F0F0F0", "domainColor": "#D0D0D0", "labelColor": "#606060", "titleColor": "#202020"},
    "view": {"stroke": "transparent"}
  },
  "vconcat": [
    {
      "width": "container",
      "height": 330,
      "encoding": {
        "x": {
          "field": "trade_date",
          "type": "temporal",
          "axis": {"title": null, "labels": false, "ticks": false}
        }
      },
      "layer": [
        {
          "mark": {"type": "area", "opacity": 0.12, "color": "#1A73E8"},
          "encoding": {
            "y": {"field": "bb_lower", "type": "quantitative", "scale": {"zero": false}, "axis": {"title": "Price (NPR)"}},
            "y2": {"field": "bb_upper"}
          }
        },
        {
          "mark": {"type": "line", "color": "#F2994A", "strokeWidth": 1.8},
          "encoding": {
            "y": {"field": "sma_20", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "rule", "strokeWidth": 1.2},
          "encoding": {
            "y": {"field": "low_price", "type": "quantitative"},
            "y2": {"field": "high_price"},
            "color": {
              "condition": {"test": "datum.close_price >= datum.open_price", "value": "#27AE60"},
              "value": "#EB5757"
            }
          }
        },
        {
          "mark": {"type": "bar", "width": {"band": 0.7}},
          "encoding": {
            "y": {"field": "open_price", "type": "quantitative"},
            "y2": {"field": "close_price"},
            "color": {
              "condition": {"test": "datum.close_price >= datum.open_price", "value": "#27AE60"},
              "value": "#EB5757"
            },
            "tooltip": [
              {"field": "trade_date", "type": "temporal", "title": "Date", "format": "%Y-%m-%d"},
              {"field": "open_price", "type": "quantitative", "title": "Open (NPR)", "format": ",.2f"},
              {"field": "high_price", "type": "quantitative", "title": "High (NPR)", "format": ",.2f"},
              {"field": "low_price", "type": "quantitative", "title": "Low (NPR)", "format": ",.2f"},
              {"field": "close_price", "type": "quantitative", "title": "Close (NPR)", "format": ",.2f"},
              {"field": "volume", "type": "quantitative", "title": "Volume", "format": ","},
              {"field": "candle_pattern", "type": "nominal", "title": "Pattern"},
              {"field": "signal_decision", "type": "nominal", "title": "Signal"}
            ]
          }
        },
        {
          "mark": {"type": "point", "shape": "triangle-up", "filled": true, "size": 130, "color": "#2F80ED"},
          "encoding": {
            "y": {"field": "buy_marker_price", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "point", "shape": "triangle-down", "filled": true, "size": 130, "color": "#9B51E0"},
          "encoding": {
            "y": {"field": "sell_marker_price", "type": "quantitative"}
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 90,
      "mark": {"type": "bar", "width": {"band": 0.7}, "opacity": 0.8},
      "encoding": {
        "x": {
          "field": "trade_date",
          "type": "temporal",
          "axis": {"title": "Trading Date", "format": "%b %Y"}
        },
        "y": {
          "field": "volume",
          "type": "quantitative",
          "axis": {"title": "Volume", "tickCount": 3, "format": "~s"}
        },
        "color": {
          "condition": {"test": "datum.close_price >= datum.open_price", "value": "#81C995"},
          "value": "#F28B82"
        }
      }
    }
  ],
  "resolve": {"scale": {"x": "shared"}}
}